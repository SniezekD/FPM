FoamFile
{
    version   2.0;
    format    ascii;
    class     dictionary;
    location  "system";
    object    meshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

surfaceFile "constant/triSurface/col_model.fms";

minCellSize {{ min_cell_size }};

maxCellSize  {{ max_cell_size }};


localRefinement
{
    "grain*"
    {
        additionalRefinementLevel {{ additional_refinement_lvl }};
        refinementThickness {{ refinement_thickness }};
    }
}


