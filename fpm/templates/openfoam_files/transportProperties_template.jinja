FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


//- For simpleFoam

{% if transport_model is not none and params_list is not none%}   
    transportModel  {{ transport_model }};
    {{ transport_model }}Coeffs
    {
        {% for param in params_list %}
        {{ param.name }}  {{ param.value }};
        {% endfor %}
    }
{% else %}
    transportModel Newtonian;
    nu              {{ kin_viscosity }};
{% endif %}


// ************************************************************************* //
