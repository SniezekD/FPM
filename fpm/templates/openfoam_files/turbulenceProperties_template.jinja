FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

{% if turbulence_model is not none%}
    simulationType {{ turbulence_model }};
{% elif transport_model is not none and params_list is not none%}   
    simulationType  {{ transport_model }};

    {{ transport_model }}Coeffs
    {
        {% for param in params_list %}
        {{ param.name }}  {{ param.value }};
        {% endfor %}
    }
{% elif viscosity_model is not none and params_list is not none%}
    simulationType {{ turbulence_model }};
    {{ turbulence_model }}
    {
        model               generalisedNewtonian;
        viscosityModel     {{ viscosity_model}};
        {% for param in params_list %}
        {{ param.name }}  {{ param.value }};
        {% endfor %}
    }
{% else %}
    simulationType laminar;
{% endif %}

// ************************************************************************* //
