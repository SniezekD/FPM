FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

{% if turbulence_model is defined and turbulence_model is not none and params_list is defined and params_list is not none %}
    simulationType {{ turbulence_model }};

    {{ turbulence_model }}Coeffs
    {
        {% for param in params_list %}
        {{ param.name }}  {{ param.value }};
        {% endfor %}
    }

{% else %}
    simulationType laminar;
{% endif %}

